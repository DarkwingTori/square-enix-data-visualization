# Square Enix Data Visualization — Environment Variables
# Copy this file to .env and fill in your credentials.
#
# IGDB API (free):
#   1. Create a Twitch Developer account at https://dev.twitch.tv/
#   2. Register a new application at https://dev.twitch.tv/console/apps
#   3. Set OAuth Redirect URL to http://localhost
#   4. Copy the Client ID and generate a Client Secret below.

IGDB_CLIENT_ID=your_twitch_client_id_here
IGDB_CLIENT_SECRET=your_twitch_client_secret_here
